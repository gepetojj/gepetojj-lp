---
import type { Translations } from "../../i18n";

interface Props {
	t: Translations;
}

const { t } = Astro.props;
---

<section class="band" aria-labelledby="pillars-title">
	<div class="container">
		<div class="head-split" data-reveal>
			<h2 id="pillars-title">{t.pillars.title}</h2>
			<p class="lead">{t.pillars.subtitle}</p>
		</div>
		<ul class="rows rows--field" data-reveal>
			{
				t.pillars.items.map((item) => (
					<li>
						<h3>{item.title}</h3>
						<p>{item.description}</p>
					</li>
				))
			}
		</ul>
	</div>
</section>
