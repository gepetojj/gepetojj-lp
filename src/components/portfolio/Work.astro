---
import { Image } from "astro:assets";
import { getWorkPreviewImage } from "../../data/work-preview-images";
import type { Translations } from "../../i18n";

interface Props {
	t: Translations;
}

const { t } = Astro.props;
const [lead, ...pair] = t.work.projects.slice(0, 3);
---

<section id="trabalho" class="section showcase">
	<div class="container">
		<div class="head-split" data-reveal>
			<h2>{t.work.title}</h2>
			<p class="lead">{t.work.subtitle}</p>
		</div>

		<a
			href={lead.href}
			target="_blank"
			rel="noopener noreferrer"
			class="shot shot--lead"
			style={`--work-accent: ${lead.accent}`}
			data-reveal
		>
			<figure class="shot-frame" data-slot="work-lead" data-kind="product" data-alt={`${lead.name}, página inicial`}>
				<Image
					src={getWorkPreviewImage(lead.domain)}
					alt={`${lead.name}, ${lead.domain}`}
					widths={[960, 1440, 2400]}
					sizes="(max-width: 60rem) 92vw, 1312px"
					loading="lazy"
					decoding="async"
				/>
			</figure>
			<span class="shot-caption">
				<span class="shot-name">{lead.name}</span>
				<span class="shot-fact">{lead.highlight}</span>
				<span class="shot-visit">{t.work.visitLive}</span>
			</span>
		</a>

		<div class="shot-pair">
			{
				pair.map((project, i) => (
					<a
						href={project.href}
						target="_blank"
						rel="noopener noreferrer"
						class:list={["shot", i === 0 ? "shot--wide" : "shot--narrow"]}
						style={`--work-accent: ${project.accent}; --i: ${i}`}
						data-reveal
					>
						<figure
							class="shot-frame"
							data-slot={`work-${i + 2}`}
							data-kind="product"
							data-alt={`${project.name}, página inicial`}
						>
							<Image
								src={getWorkPreviewImage(project.domain)}
								alt={`${project.name}, ${project.domain}`}
								widths={[720, 1080, 1440]}
								sizes="(max-width: 60rem) 92vw, 760px"
								loading="lazy"
								decoding="async"
							/>
						</figure>
						<span class="shot-caption">
							<span class="shot-name">{project.name}</span>
							<span class="shot-fact">{project.highlight}</span>
							<span class="shot-visit">{t.work.visitLive}</span>
						</span>
					</a>
				))
			}
		</div>
	</div>
</section>
