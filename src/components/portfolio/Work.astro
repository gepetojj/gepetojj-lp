---
import { Image } from "astro:assets";
import ArrowIcon from "../icons/ArrowIcon.astro";
import { getWorkPreviewImage } from "../../data/work-preview-images";
import type { Translations } from "../../i18n";

interface Props {
	t: Translations;
}

const { t } = Astro.props;
const featured = t.work.projects.slice(0, 4);
const more = t.work.projects.slice(4);
---

<section id="trabalho" class="section work">
	<div class="wrap">
		<header class="section-head" data-reveal>
			<h2 class="section-title">{t.work.title}</h2>
			<p class="section-sub">{t.work.subtitle}</p>
		</header>

		<div class="cases">
			{
				featured.map((project, index) => (
					<article
						class:list={["case", { "case--flip": index % 2 === 1 }]}
						style={`--work-accent: ${project.accent}`}
						data-reveal
					>
						<a
							href={project.href}
							target="_blank"
							rel="noopener noreferrer"
							class="case-stage"
							data-cursor={t.ui.viewProject}
							tabindex="-1"
							aria-hidden="true"
						>
							<span class="case-window">
								<span class="case-bar">
									<span class="case-url">{project.domain}</span>
								</span>
								<Image
									src={getWorkPreviewImage(project.domain)}
									alt=""
									class="case-img"
									widths={[560, 840, 1120, 1440]}
									sizes="(max-width: 900px) 92vw, 760px"
									loading={index === 0 ? "eager" : "lazy"}
									decoding="async"
								/>
							</span>
						</a>

						<div class="case-body">
							<p class="case-meta">
								<span>{project.tag}</span>
								<span class="case-meta-dot" aria-hidden="true" />
								<span>{project.domain}</span>
							</p>
							<h3 class="case-name">{project.name}</h3>
							<p class="case-highlight">{project.highlight}</p>
							<p class="case-desc">{project.description}</p>
							<ul class="case-tags">
								{project.tags.map((tag) => <li>{tag}</li>)}
							</ul>
							<a
								href={project.href}
								target="_blank"
								rel="noopener noreferrer"
								class="link-arrow"
								aria-label={`${project.name}: ${t.work.visitLive}`}
							>
								{t.work.visitLive}
								<ArrowIcon size={14} />
							</a>
						</div>
					</article>
				))
			}
		</div>

		<h3 class="sub-label" data-reveal>{t.ui.moreWork}</h3>
		<div class="more-grid">
			{
				more.map((project) => (
					<a
						href={project.href}
						target="_blank"
						rel="noopener noreferrer"
						class="more-item"
						style={`--work-accent: ${project.accent}`}
						data-cursor={t.ui.viewProject}
						data-reveal
					>
						<span class="more-stage">
							<Image
								src={getWorkPreviewImage(project.domain)}
								alt=""
								class="more-img"
								widths={[480, 720, 960]}
								sizes="(max-width: 700px) 92vw, 46vw"
								loading="lazy"
								decoding="async"
							/>
						</span>
						<span class="more-row">
							<span class="more-name">{project.name}</span>
							<span class="more-tag">{project.tag}</span>
							<ArrowIcon size={16} />
						</span>
						<span class="more-desc">{project.highlight}</span>
					</a>
				))
			}
		</div>
	</div>
</section>
