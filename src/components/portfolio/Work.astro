---
import ArrowIcon from "../icons/ArrowIcon.astro";
import type { Translations } from "../../i18n";

interface Props {
	t: Translations;
}

const { t } = Astro.props;
---

<section id="trabalho" class="section-pad">
	<div class="wrap">
		<div class="s-head" data-reveal>
			<span class="s-tag">{t.work.tag}</span>
			<h2>{t.work.title}</h2>
			<p>{t.work.subtitle}</p>
		</div>
		<div class="work-grid">
			{
				t.work.projects.map((project) => (
					<a
						href={project.href}
						target="_blank"
						rel="noopener"
						class="work-card tilt"
						data-reveal
					>
						<div class="glow" />
						<div class="work-top">
							<span class="wk-tag">{project.tag}</span>
							<h3>{project.name}</h3>
							<p>{project.description}</p>
						</div>
						<div class="work-bottom">
							<div class="tags">
								{project.tags.map((tag) => (
									<span class="tag">{tag}</span>
								))}
							</div>
							<span class="work-link">
								{project.domain}
								<ArrowIcon size={14} />
							</span>
						</div>
					</a>
				))
			}
		</div>
	</div>
</section>
