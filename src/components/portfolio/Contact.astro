---
import ArrowIcon from "../icons/ArrowIcon.astro";
import type { Translations } from "../../i18n";

interface Props {
	t: Translations;
}

const { t } = Astro.props;

const navLinks = [
	{ href: "#sobre", label: t.nav.about },
	{ href: "#trabalho", label: t.nav.work },
	{ href: "#skills", label: t.nav.stack },
	{ href: "#opensource", label: t.nav.openSource },
];

const elsewhere = [
	{ href: "https://www.linkedin.com/in/nobrejoaox/", label: "LinkedIn" },
	{ href: "https://github.com/gepetojj", label: "GitHub" },
];
---

<footer id="contato" class="closing">
	<div class="wrap">
		<div class="closing-cta">
			<h2 class="closing-title" data-reveal>
				{t.contact.title}
				<span class="closing-emph">{t.contact.titleEmphasis}</span>
			</h2>
			<div class="closing-actions" data-reveal>
				<a href="mailto:oi@gepetojj.com" class="closing-email">
					oi@gepetojj.com
					<ArrowIcon size={22} />
				</a>
				<button
					type="button"
					class="btn btn-quiet btn-sm copy-btn"
					data-copy="oi@gepetojj.com"
					data-copied-label={t.ui.copied}
				>
					<span class="copy-label">{t.ui.copy}</span>
				</button>
			</div>
		</div>

		<div class="footer-cols">
			<div class="footer-col">
				<h3 class="sub-label">{t.ui.footerNav}</h3>
				<ul>
					{navLinks.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
				</ul>
			</div>
			<div class="footer-col">
				<h3 class="sub-label">{t.ui.footerStart}</h3>
				<ul>
					<li><a href="mailto:oi@gepetojj.com">oi@gepetojj.com</a></li>
					<li><a href="https://linksolucoesbr.com/?utm_source=gepetojj.com&utm_medium=referral" target="_blank" rel="noopener">Link Soluções</a></li>
				</ul>
			</div>
			<div class="footer-col">
				<h3 class="sub-label">{t.ui.footerElsewhere}</h3>
				<ul>
					{
						elsewhere.map((link) => (
							<li>
								<a href={link.href} target="_blank" rel="noopener">
									{link.label}
								</a>
							</li>
						))
					}
				</ul>
			</div>
			<div class="footer-col footer-status">
				<h3 class="sub-label">{t.ui.statusLabel}</h3>
				<p><i class="status-dot" aria-hidden="true"></i>{t.contact.subtitle}</p>
			</div>
		</div>

		<div class="footer-base">
			<p>{t.footer.copyright}</p>
			<a href="#top" class="link-arrow">{t.footer.backToTop}</a>
		</div>
	</div>

	<div class="footer-wordmark" aria-hidden="true">gepetojj</div>
</footer>
