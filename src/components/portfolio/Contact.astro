---
import type { Translations } from "../../i18n";

interface Props {
	t: Translations;
}

const { t } = Astro.props;

const links = [
	{ href: "#trabalho", label: t.nav.work },
	{ href: "#sobre", label: t.nav.about },
	{ href: "#skills", label: t.nav.stack },
	{ href: "#opensource", label: t.nav.openSource },
];

const elsewhere = [
	{ href: "https://www.linkedin.com/in/nobrejoaox/", label: "LinkedIn" },
	{ href: "https://github.com/gepetojj", label: "GitHub" },
];
---

<footer id="contato" class="closing">
	<div class="container">
		<h2 class="closing-title" data-reveal>
			{t.contact.title}<br />{t.contact.titleEmphasis}
		</h2>
		<p class="lead closing-sub" data-reveal>{t.contact.subtitle}</p>

		<div class="closing-actions" data-reveal>
			<a href="mailto:oi@gepetojj.com" class="closing-email">oi@gepetojj.com</a>
			<button
				type="button"
				class="btn btn--quiet copy-btn"
				data-copy="oi@gepetojj.com"
				data-copied-label={t.ui.copied}
			>
				<span class="copy-label" aria-live="polite">{t.ui.copy}</span>
			</button>
		</div>

		<div class="footer-row">
			<ul class="footer-links">
				{links.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
				{
					elsewhere.map((link) => (
						<li>
							<a href={link.href} target="_blank" rel="noopener">
								{link.label}
							</a>
						</li>
					))
				}
			</ul>
			<p class="footer-place">
				{t.ui.location}<br />
				João Nobre, {t.hero.alias} <code>gepetojj</code>
			</p>
		</div>

		<div class="footer-base">
			<p>{t.footer.copyright}</p>
			<a href="#top" class="text-link">{t.footer.backToTop}</a>
		</div>
	</div>
</footer>
