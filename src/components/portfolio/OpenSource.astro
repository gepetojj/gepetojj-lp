---
import NpmIcon from "../icons/NpmIcon.astro";
import type { Translations } from "../../i18n";

interface Props {
	t: Translations;
}

const { t } = Astro.props;
---

<section id="opensource" class="section oss">
	<div class="container">
		<div class="head-split" data-reveal>
			<h2>{t.openSource.title}</h2>
			<p class="lead">{t.openSource.subtitle}</p>
		</div>

		<ul class="repo-list" data-reveal>
			{
				t.openSource.repos.map((repo) => (
					<li>
						<a href={repo.href} target="_blank" rel="noopener" class="repo">
							<span class="repo-name">
								{repo.npm && <NpmIcon size={16} className="repo-npm" />}
								<code>{repo.name}</code>
							</span>
							<span class="repo-desc">{repo.description}</span>
							<span class="repo-lang">{repo.lang}</span>
						</a>
					</li>
				))
			}
		</ul>

		<a href="https://github.com/gepetojj" target="_blank" rel="noopener" class="text-link oss-more" data-reveal>
			{t.openSource.githubCta}
		</a>
	</div>
</section>
