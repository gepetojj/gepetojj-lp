---
import ArrowIcon from "../icons/ArrowIcon.astro";
import NpmIcon from "../icons/NpmIcon.astro";
import type { Translations } from "../../i18n";

interface Props {
	t: Translations;
}

const { t } = Astro.props;
---

<section id="opensource" class="section oss">
	<div class="wrap">
		<header class="section-head" data-reveal>
			<h2 class="section-title">{t.openSource.title}</h2>
			<p class="section-sub">{t.openSource.subtitle}</p>
		</header>

		<ul class="repo-list" data-reveal>
			{
				t.openSource.repos.map((repo) => (
					<li>
						<a href={repo.href} target="_blank" rel="noopener" class="repo">
							<span class="repo-name">
								{repo.npm && <NpmIcon size={16} className="repo-npm" />}
								{repo.name}
							</span>
							<span class="repo-desc">{repo.description}</span>
							<span class="repo-lang">
								<i style={`background:${repo.langColor}`} aria-hidden="true" />
								{repo.lang}
							</span>
							<span class="repo-arrow" aria-hidden="true">
								<ArrowIcon size={16} />
							</span>
						</a>
					</li>
				))
			}
		</ul>

		<a
			href="https://github.com/gepetojj"
			target="_blank"
			rel="noopener"
			class="link-arrow oss-more"
			data-reveal
		>
			{t.openSource.githubCta}
			<ArrowIcon size={14} />
		</a>
	</div>
</section>
