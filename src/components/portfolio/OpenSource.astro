---
import ArrowIcon from "../icons/ArrowIcon.astro";
import NpmIcon from "../icons/NpmIcon.astro";
import type { Translations } from "../../i18n";

interface Props {
	t: Translations;
}

const { t } = Astro.props;
---

<section
	id="opensource"
	class="section-pad"
	style="background:var(--bg-soft);border-top:1px solid var(--border);border-bottom:1px solid var(--border);"
>
	<div class="wrap">
		<div class="s-head" data-reveal>
			<span class="s-tag">{t.openSource.tag}</span>
			<h2>{t.openSource.title}</h2>
			<p>{t.openSource.subtitle}</p>
		</div>
		<div class="repo-grid">
			{
				t.openSource.repos.map((repo) => (
					<a
						href={repo.href}
						target="_blank"
						rel="noopener"
						class="repo-card tilt"
						data-reveal
					>
						<div>
							<h4 class="repo-name">
								{repo.npm && (
									<NpmIcon size={18} className="repo-npm-icon" />
								)}
								{repo.name}
							</h4>
							<p>{repo.description}</p>
						</div>
						<div class="repo-meta">
							<span class="lang-dot">
								<span style={`background:${repo.langColor};`}></span>
								{repo.lang}
							</span>
							<svg
								class="arrow"
								viewBox="0 0 24 24"
								fill="none"
								stroke="currentColor"
								stroke-width="2"
							>
								<path d="M7 17L17 7M17 7H8M17 7V16"></path>
							</svg>
						</div>
					</a>
				))
			}
		</div>
		<div class="gh-more" data-reveal>
			<a href="https://github.com/gepetojj" target="_blank" rel="noopener" class="btn btn-secondary magnetic">
				{t.openSource.githubCta}
				<ArrowIcon />
			</a>
		</div>
	</div>
</section>
