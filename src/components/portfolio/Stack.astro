---
import SkillIcon from "../icons/SkillIcon.astro";
import type { Translations } from "../../i18n";

interface Props {
	t: Translations;
}

const { t } = Astro.props;
---

<section id="skills" class="section stack">
	<div class="container">
		<div class="head-split" data-reveal>
			<h2>{t.stack.title}</h2>
			<p class="lead">{t.stack.subtitle}</p>
		</div>

		<table class="stack-table" data-reveal>
			<caption class="visually-hidden">{t.stack.technicalLabel}</caption>
			<thead>
				<tr>
					<th scope="col">{t.ui.colArea}</th>
					<th scope="col">{t.ui.colWhat}</th>
					<th scope="col">{t.ui.colTools}</th>
				</tr>
			</thead>
			<tbody>
				{
					t.stack.categories.map((category) => (
						<tr>
							<th scope="row">
								<span class="stack-area">
									<SkillIcon icon={category.icon} />
									{category.title}
								</span>
							</th>
							<td data-label={t.ui.colWhat}>{category.description}</td>
							<td data-label={t.ui.colTools} class="stack-tools">{category.tags.join(", ")}</td>
						</tr>
					))
				}
			</tbody>
		</table>
	</div>
</section>
