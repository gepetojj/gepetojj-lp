---
import SkillIcon from "../icons/SkillIcon.astro";
import type { Translations } from "../../i18n";

interface Props {
	t: Translations;
}

const { t } = Astro.props;
---

<section id="skills" class="section stack">
	<div class="wrap">
		<header class="section-head" data-reveal>
			<h2 class="section-title">{t.stack.title}</h2>
			<p class="section-sub">{t.stack.subtitle}</p>
		</header>

		<div class="stack-layout">
			<div class="stack-block" data-reveal>
				<h3 class="sub-label">{t.stack.technicalLabel}</h3>
				<ul class="stack-table">
					{
						t.stack.categories.map((category) => (
							<li class="stack-row">
								<span class="stack-icon">
									<SkillIcon icon={category.icon} />
								</span>
								<span class="stack-cat">
									<span class="stack-title">{category.title}</span>
									<span class="stack-desc">{category.description}</span>
								</span>
								<span class="stack-tags">{category.tags.join(" / ")}</span>
							</li>
						))
					}
				</ul>
			</div>

			<div class="stack-block" data-reveal>
				<h3 class="sub-label">{t.stack.leadershipLabel}</h3>
				<dl class="leadership">
					{
						t.stack.leadership.map((item) => (
							<div class="leadership-item">
								<dt>{item.title}</dt>
								<dd>{item.description}</dd>
							</div>
						))
					}
				</dl>
			</div>
		</div>
	</div>
</section>
