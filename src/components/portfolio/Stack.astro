---
import SkillIcon from "../icons/SkillIcon.astro";
import type { Translations } from "../../i18n";

interface Props {
	t: Translations;
}

const { t } = Astro.props;
---

<section
	id="skills"
	class="section-pad"
	style="background:var(--bg-soft);border-top:1px solid var(--border);border-bottom:1px solid var(--border);"
>
	<div class="wrap">
		<div class="s-head" data-reveal>
			<span class="s-tag">{t.stack.tag}</span>
			<h2>{t.stack.title}</h2>
			<p>{t.stack.subtitle}</p>
		</div>

		<div class="skills-group" data-reveal>
			<h3 class="skills-group-label">{t.stack.technicalLabel}</h3>
			<div class="stack-grid">
				{
					t.stack.categories.map((category) => (
						<div class="stack-card tilt" data-reveal>
							<SkillIcon icon={category.icon} />
							<h4>{category.title}</h4>
							<div class="sdesc">{category.description}</div>
							<div class="tags">
								{category.tags.map((tag) => (
									<span class="tag">{tag}</span>
								))}
							</div>
						</div>
					))
				}
			</div>
		</div>

		<div class="skills-group skills-group--leadership" data-reveal>
			<h3 class="skills-group-label">{t.stack.leadershipLabel}</h3>
			<div class="skills-leadership">
				{
					t.stack.leadership.map((item) => (
						<div class="skills-leadership-item" data-reveal>
							<h4>{item.title}</h4>
							<p>{item.description}</p>
						</div>
					))
				}
			</div>
		</div>
	</div>
</section>
