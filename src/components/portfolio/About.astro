---
import type { Translations } from "../../i18n";

interface Props {
	t: Translations;
}

const { t } = Astro.props;
const figures = t.about.proofLine.split(" · ").map((line) => {
	const [figure, ...rest] = line.split(" ");
	return { figure, label: rest.join(" ") };
});
---

<section id="sobre" class="section about">
	<div class="container">
		<h2 class="statement" data-reveal>{t.about.title}</h2>

		<div class="about-grid">
			<div class="about-prose" data-reveal>
				{t.about.paragraphs.map((paragraph) => <p set:html={paragraph} />)}
			</div>
			<dl class="figures" data-reveal>
				{
					figures.map((item) => (
						<div>
							<dt class="figure">{item.figure}</dt>
							<dd>{item.label}</dd>
						</div>
					))
				}
			</dl>
		</div>
	</div>
</section>
