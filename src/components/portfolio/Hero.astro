---
import { Image } from "astro:assets";
import portraitDither from "../../assets/eu-dither.png";
import portrait from "../../assets/eu.png";
import type { Translations } from "../../i18n";

interface Props {
	t: Translations;
}

const { t } = Astro.props;
---

<header class="hero">
	<div class="container stage-grid">
		<div class="stage-copy settle">
			<h1 class="stage-name">{t.hero.name}</h1>
			<p class="lead stage-lead">{t.hero.lead}</p>
			<div class="stage-actions">
				<a href="mailto:oi@gepetojj.com" class="btn">oi@gepetojj.com</a>
				<a href="#trabalho" class="btn btn--quiet">{t.hero.ctaWork}</a>
			</div>
		</div>

		<figure
			class="portrait settle"
			data-slot="hero"
			data-alt="Retrato de João Nobre, tratado em pontilhado de 1 bit"
			data-waves
		>
			<Image
				src={portraitDither}
				alt={t.hero.portraitAlt}
				class="portrait-dither"
				widths={[1040]}
				sizes="(max-width: 60rem) 90vw, 640px"
				format="png"
				loading="eager"
				fetchpriority="high"
			/>
			<Image
				src={portrait}
				alt=""
				aria-hidden="true"
				class="portrait-photo"
				widths={[640, 1040]}
				sizes="(max-width: 60rem) 90vw, 640px"
				loading="eager"
			/>
		</figure>
	</div>
</header>
