---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
	domain: string;
	previewImage: ImageMetadata;
	alt: string;
	highlight: string;
	compact?: boolean;
}

const { domain, previewImage, alt, highlight, compact = false } = Astro.props;
---

<div class:list={["work-preview", { "work-preview--compact": compact }]}>
	<div class="work-frame">
		<div class="work-frame-bar">
			<div class="work-frame-dots" aria-hidden="true">
				<span></span><span></span><span></span>
			</div>
			<span class="work-frame-url">{domain}</span>
		</div>
		<div class="work-frame-screen">
			<Image
				src={previewImage}
				alt={alt}
				class="work-preview-img"
				widths={[480, 720, 960, 1200]}
				sizes="(max-width: 640px) 100vw, (max-width: 900px) 50vw, 460px"
				loading="lazy"
				decoding="async"
			/>
		</div>
	</div>
	<span class="work-highlight">{highlight}</span>
</div>
