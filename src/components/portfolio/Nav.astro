---
import { getRelativeLocaleUrl } from "astro:i18n";
import ArrowIcon from "../icons/ArrowIcon.astro";
import {
	LOCALE_LABELS,
	LOCALES,
	type Locale,
	type Translations,
} from "../../i18n";

interface Props {
	t: Translations;
	locale: Locale;
}

const { t, locale } = Astro.props;

const navLinks = [
	{ href: "#sobre", label: t.nav.about },
	{ href: "#trabalho", label: t.nav.work },
	{ href: "#skills", label: t.nav.stack },
	{ href: "#opensource", label: t.nav.openSource },
] as const;
---

<nav id="nav" class="nav">
	<div class="wrap nav-inner">
		<a href="#top" class="nav-brand" aria-label="gepetojj — João Nobre">
			<svg class="nav-mark" viewBox="0 0 67 85" fill="none" aria-hidden="true">
				<path
					d="M6.52779 23.9671L33.6132 5.72298C32.7334 45.7847 37.4865 70.9082 4.89391 72.2662M59.8939 43.7477L32.3822 61.402C32.3822 60.2587 31.8938 56.8752 32.7939 43.3838M32.3822 61.8918V84.7546"
					stroke="currentColor"
					stroke-width="7"></path>
			</svg>
			<span class="nav-wordmark">gepetojj</span>
		</a>

		<div class="nav-links">
			{
				navLinks.map((link) => (
					<a href={link.href} data-link>
						{link.label}
					</a>
				))
			}
		</div>

		<div class="nav-end">
			<div class="locale-switcher" role="navigation" aria-label={t.nav.localeSwitcher}>
				{
					LOCALES.map((code) => (
						<a
							href={getRelativeLocaleUrl(code)}
							class:list={["locale-link", { active: code === locale }]}
							hreflang={code}
							aria-current={code === locale ? "page" : undefined}
						>
							{LOCALE_LABELS[code]}
						</a>
					))
				}
			</div>
			<a href="#contato" class="btn btn-accent btn-sm nav-cta">{t.nav.cta}</a>
			<button
				type="button"
				class="nav-toggle"
				id="navToggle"
				aria-expanded="false"
				aria-controls="navDrawer"
				aria-label="Menu"
			>
				<span class="nav-toggle-icon" aria-hidden="true"><i></i><i></i></span>
			</button>
		</div>
	</div>
</nav>

<div class="nav-drawer" id="navDrawer" aria-hidden="true" inert>
	<div class="wrap nav-drawer-inner">
		<ul class="nav-drawer-list">
			{
				[...navLinks, { href: "#contato", label: t.nav.contact }].map((link, index) => (
					<li style={`--i: ${index}`}>
						<a href={link.href} data-link class="nav-drawer-link">
							{link.label}
						</a>
					</li>
				))
			}
		</ul>
		<div class="nav-drawer-footer">
			<a href="mailto:oi@gepetojj.com" class="btn btn-accent">
				oi@gepetojj.com
				<ArrowIcon />
			</a>
			<div class="locale-switcher" role="navigation" aria-label={t.nav.localeSwitcher}>
				{
					LOCALES.map((code) => (
						<a
							href={getRelativeLocaleUrl(code)}
							class:list={["locale-link", { active: code === locale }]}
							hreflang={code}
							aria-current={code === locale ? "page" : undefined}
						>
							{LOCALE_LABELS[code]}
						</a>
					))
				}
			</div>
		</div>
	</div>
</div>
