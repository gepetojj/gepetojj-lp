---
import { Image } from "astro:assets";
import { getRelativeLocaleUrl } from "astro:i18n";
import logo from "../../assets/logo.svg";
import ArrowIcon from "../icons/ArrowIcon.astro";
import {
	LOCALE_LABELS,
	LOCALES,
	type Locale,
	type Translations,
} from "../../i18n";

interface Props {
	t: Translations;
	locale: Locale;
}

const { t, locale } = Astro.props;

const navLinks = [
	{ href: "#sobre", label: t.nav.about },
	{ href: "#skills", label: t.nav.stack },
	{ href: "#trabalho", label: t.nav.work },
	{ href: "#opensource", label: t.nav.openSource },
	{ href: "#contato", label: t.nav.contact },
] as const;
---

<nav id="nav">
	<div class="wrap">
		<a href="#top" class="nav-brand" aria-label="gepetojj">
			<Image src={logo} alt="Logo" width={20} aria-hidden="true" loading="eager" />
			<div class="logo">gepeto<span class="w-0">jj</span></div>
		</a>

		<div class="navlinks navlinks--desktop">
			{
				navLinks.map((link) => (
					<a href={link.href} data-link>
						{link.label}
					</a>
				))
			}
		</div>

		<div class="nav-end">
			<div class="locale-switcher" role="navigation" aria-label={t.nav.localeSwitcher}>
				{
					LOCALES.map((code) => (
						<a
							href={getRelativeLocaleUrl(code)}
							class:list={["locale-link", { active: code === locale }]}
							hreflang={code}
							aria-current={code === locale ? "page" : undefined}
						>
							{LOCALE_LABELS[code]}
						</a>
					))
				}
			</div>
			<a href="mailto:oi@gepetojj.com" class="nav-cta nav-cta--bar magnetic">{t.nav.cta}</a>
			<a href="mailto:oi@gepetojj.com" class="nav-cta nav-cta--mobile magnetic" aria-label={t.nav.cta}>
				{t.nav.cta}
			</a>
			<button
				type="button"
				class="nav-toggle"
				id="navToggle"
				aria-expanded="false"
				aria-controls="navDrawer"
				aria-label="Menu"
			>
				<span class="nav-toggle-icon" aria-hidden="true">
					<i></i>
					<i></i>
					<i></i>
				</span>
			</button>
		</div>
	</div>
</nav>

<div class="nav-drawer" id="navDrawer" aria-hidden="true" inert>
	<div class="nav-drawer-bg" aria-hidden="true">
		<div class="nav-drawer-grid"></div>
		<div class="nav-drawer-glow"></div>
	</div>

	<div class="nav-drawer-content wrap">
		<ul class="nav-drawer-list">
			{
				navLinks.map((link, index) => (
					<li style={`--i: ${index}`}>
						<a href={link.href} data-link class="nav-drawer-link">
							<span class="nav-drawer-num">{String(index + 1).padStart(2, "0")}</span>
							<span class="nav-drawer-label">{link.label}</span>
						</a>
					</li>
				))
			}
		</ul>

		<div class="nav-drawer-footer">
			<a href="mailto:oi@gepetojj.com" class="btn btn-primary magnetic nav-drawer-cta">
				{t.nav.cta}
				<ArrowIcon />
			</a>
			<span class="nav-drawer-email">oi@gepetojj.com</span>
		</div>
	</div>
</div>
