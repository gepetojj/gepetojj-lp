---
import { getRelativeLocaleUrl } from "astro:i18n";
import {
	LOCALE_LABELS,
	LOCALES,
	type Locale,
	type Translations,
} from "../../i18n";

interface Props {
	t: Translations;
	locale: Locale;
}

const { t, locale } = Astro.props;

const navLinks = [
	{ href: "#trabalho", label: t.nav.work },
	{ href: "#sobre", label: t.nav.about },
	{ href: "#skills", label: t.nav.stack },
	{ href: "#opensource", label: t.nav.openSource },
] as const;
---

<nav id="nav" class="nav">
	<div class="container nav-inner">
		<a href="#top" class="nav-brand" aria-label="gepetojj, João Nobre">
			<svg class="nav-mark" viewBox="12 2 42 60" fill="none" aria-hidden="true">
				<g stroke="currentColor" stroke-width="6">
					<path d="M32 5V59"></path>
					<path d="M32 8H41C55 8 55 25 32 32C9 39 9 56 23 56H32"></path>
				</g>
				<circle class="nav-mark-grain" cx="32" cy="32" r="3.6"></circle>
			</svg>
			<span class="nav-wordmark">gepetojj</span>
		</a>

		<div class="nav-links">
			{
				navLinks.map((link) => (
					<a href={link.href} data-link>
						{link.label}
					</a>
				))
			}
		</div>

		<div class="nav-end">
			<div class="locale-switcher" role="navigation" aria-label={t.nav.localeSwitcher}>
				{
					LOCALES.map((code) => (
						<a
							href={getRelativeLocaleUrl(code)}
							class:list={["locale-link", { active: code === locale }]}
							hreflang={code}
							aria-current={code === locale ? "page" : undefined}
						>
							{LOCALE_LABELS[code]}
						</a>
					))
				}
			</div>
			<a href="#contato" class="btn btn--quiet nav-cta">{t.nav.cta}</a>
			<button
				type="button"
				class="nav-toggle"
				id="navToggle"
				aria-expanded="false"
				aria-controls="navDrawer"
				aria-label="Menu"
			>
				<span class="nav-toggle-icon" aria-hidden="true"><i></i><i></i></span>
			</button>
		</div>
	</div>
</nav>

<div class="nav-drawer" id="navDrawer" aria-hidden="true" inert>
	<div class="container nav-drawer-inner">
		<ul class="nav-drawer-list">
			{
				[...navLinks, { href: "#contato", label: t.nav.contact }].map((link, index) => (
					<li style={`--i: ${index}`}>
						<a href={link.href} data-link class="nav-drawer-link">
							{link.label}
						</a>
					</li>
				))
			}
		</ul>
		<div class="nav-drawer-footer">
			<a href="mailto:oi@gepetojj.com" class="nav-drawer-email">oi@gepetojj.com</a>
			<div class="locale-switcher" role="navigation" aria-label={t.nav.localeSwitcher}>
				{
					LOCALES.map((code) => (
						<a
							href={getRelativeLocaleUrl(code)}
							class:list={["locale-link", { active: code === locale }]}
							hreflang={code}
							aria-current={code === locale ? "page" : undefined}
						>
							{LOCALE_LABELS[code]}
						</a>
					))
				}
			</div>
		</div>
	</div>
</div>
