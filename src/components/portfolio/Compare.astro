---
import type { Translations } from "../../i18n";

interface Props {
	t: Translations;
}

const { t } = Astro.props;
---

<section id="diferencial" class="section-pad">
	<div class="wrap">
		<div class="s-head" data-reveal>
			<span class="s-tag">{t.compare.tag}</span>
			<h2>{t.compare.title}</h2>
			<p>{t.compare.subtitle}</p>
		</div>
		<div class="compare" data-reveal>
			<div class="compare-head">
				<div>{t.compare.common}</div>
				<div>{t.compare.mine}</div>
			</div>
			{
				t.compare.rows.map((row) => (
					<div class="compare-row" data-reveal>
						<div class="c-left">
							<b>—</b> {row.left}
						</div>
						<div class="c-right">
							<b>✓</b> {row.right}
						</div>
					</div>
				))
			}
		</div>
	</div>
</section>
