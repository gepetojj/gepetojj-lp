---
import type { Locale } from "../i18n";
import { getLocaleUrl, useTranslations } from "../i18n";
import Layout from "../layouts/Layout.astro";
import Nav from "./portfolio/Nav.astro";
import Hero from "./portfolio/Hero.astro";
import About from "./portfolio/About.astro";
import Work from "./portfolio/Work.astro";
import Pillars from "./portfolio/Pillars.astro";
import Stack from "./portfolio/Stack.astro";
import OpenSource from "./portfolio/OpenSource.astro";
import Contact from "./portfolio/Contact.astro";

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const canonical = getLocaleUrl(locale);
---

<Layout locale={locale} t={t} canonical={canonical}>
	<a href="#conteudo" class="skip-link">{t.ui.skip}</a>
	<Nav t={t} locale={locale} />
	<main id="conteudo">
		<Hero t={t} />
		<About t={t} />
		<Work t={t} />
		<Pillars t={t} />
		<Stack t={t} />
		<OpenSource t={t} />
	</main>
	<Contact t={t} />

	<script>
		import "../scripts/portfolio.ts";
	</script>
</Layout>
