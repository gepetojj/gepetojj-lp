---
import { SITE, absoluteUrl } from "../../config/site";
import type { Locale } from "../../i18n";
import {
	getDefaultLocaleUrl,
	getLocaleAlternates,
	getOgLocale,
} from "../../i18n";

interface Props {
	locale: Locale;
	title: string;
	description: string;
	keywords: readonly string[];
	ogImageAlt: string;
	canonical: string;
	ogImage?: string;
	noindex?: boolean;
}

const {
	locale,
	title,
	description,
	keywords,
	ogImageAlt,
	canonical,
	ogImage = SITE.ogImage,
	noindex = false,
} = Astro.props;

const ogImageUrl = absoluteUrl(ogImage);
const robots = noindex
	? "noindex, nofollow"
	: "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1";
const alternates = getLocaleAlternates();
---

<title>{title}</title>
<meta name="description" content={description} />
<meta name="keywords" content={keywords.join(", ")} />
<meta name="author" content={SITE.author.name} />
<meta name="creator" content={SITE.author.alternateName} />
<meta name="publisher" content={SITE.author.name} />
<meta name="robots" content={robots} />
<meta name="googlebot" content={robots} />
<meta name="theme-color" content={SITE.themeColor} />
<meta name="color-scheme" content="dark" />
<meta name="format-detection" content="telephone=no" />

<meta name="geo.region" content={`${SITE.author.location.country}-${SITE.author.location.region}`} />
<meta name="geo.placename" content={SITE.author.location.city} />
<meta name="ICBM" content="-9.7548,-36.6611" />

<link rel="canonical" href={canonical} />
{
	alternates.map((alt) => (
		<link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
	))
}
<link rel="alternate" hreflang="x-default" href={getDefaultLocaleUrl()} />
<link rel="author" href={SITE.url} />
{SITE.author.sameAs.map((url) => <link rel="me" href={url} />)}

<meta property="og:type" content="profile" />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:locale" content={getOgLocale(locale)} />
<meta property="og:url" content={canonical} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:image:secure_url" content={ogImageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={ogImageAlt} />
<meta property="profile:username" content={SITE.author.alternateName} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageUrl} />
<meta name="twitter:image:alt" content={ogImageAlt} />
<meta name="twitter:creator" content={`@${SITE.author.alternateName}`} />
